# The muttrc the parity passes are measured against: 95 settings, the
# ones that turn up in every dotfiles repo. What --import-muttrc still
# calls "no rmut equivalent" here is the list the roadmap works down.
set realname = "Jane Doe"
set from = "jane@example.com"
set folder = "imaps://imap.example.com/"
set spoolfile = "+INBOX"
set record = "+Sent"
set postponed = "+Drafts"
set trash = "+Trash"
set imap_user = "jane@example.com"
set imap_pass = "hunter2"
set smtp_url = "smtps://jane@example.com@smtp.example.com:465/"
set smtp_pass = "hunter2"
set ssl_force_tls = yes
set ssl_starttls = yes
set hostname = mail.example.net
set user_agent = yes
set sig_on_top = yes
set ssl_usesystemcerts = yes
set certificate_file = "~/.mutt/certs.pem"
set imap_idle = yes
set imap_keepalive = 300
set imap_check_subscribed = yes
set mail_check = 60
set timeout = 15
set header_cache = "~/.cache/mutt/headers"
set message_cachedir = "~/.cache/mutt/bodies"
set editor = "vim"
set sendmail = "/usr/sbin/sendmail -oi"
set sort = threads
set sort_aux = reverse-last-date-received
set strict_threads = yes
set sort_re = yes
set reply_regexp = "^(re|aw):[ \t]*"
set duplicate_threads = no
set hide_missing = yes
set narrow_tree = no
set collapse_unread = no
set uncollapse_jump = yes
set pager_stop = yes
set pager_index_lines = 8
set pager_context = 3
set menu_scroll = yes
set markers = no
set smart_wrap = yes
set tilde = yes
set wrap = 100
set quit = ask-yes
set confirmappend = no
set delete = yes
set move = no
set save_name = yes
set force_name = no
set wait_key = no
set beep = no
set beep_new = yes
set mark_old = no
set index_format = "%4C %Z %{%b %d} %-15.15F %s"
set status_format = "-%r-rmut: %f [Msgs:%?M?%M/?%m%?n? New:%n?]---(%s/%S)-%>-(%P)---"
set pager_format = "-%Z- %C/%m: %-20.20n   %s%*  -- (%P)"
set date_format = "!%a, %b %d, %Y at %I:%M:%S%p %Z"
set attribution = "On %d, %n wrote:"
set indent_string = "> "
set forward_format = "Fwd: %s"
set forward_quote = yes
set include = yes
set fast_reply = yes
set askcc = yes
set askbcc = no
set reply_to = ask-yes
set reverse_name = yes
set reverse_realname = no
set metoo = no
set edit_headers = yes
set abort_nosubject = ask-yes
set abort_unmodified = yes
set copy = yes
set text_flowed = yes
set sig_dashes = yes
set signature = "~/.signature"
set alias_file = "~/.mutt/aliases"
set sidebar_visible = yes
set sidebar_width = 24
set sidebar_format = "%B%?F? [%F]?%* %?N?%N/?%S"
set sidebar_short_path = yes
set sidebar_folder_indent = yes
set mailcap_path = "~/.mailcap"
set implicit_autoview = yes
set mime_forward = ask-no
set honor_followup_to = yes
set crypt_use_gpgme = yes
set crypt_autosign = no
set crypt_replysign = yes
set crypt_verify_sig = yes
set pgp_use_gpg_agent = yes
set charset = "utf-8"
set assumed_charset = "iso-8859-1"
set send_charset = "us-ascii:utf-8"
set allow_8bit = yes
set print_command = "muttprint"
set print = ask-no
set folder_format = "%2C %t %N %F %2l %-8.8u %-8.8g %8s %d %f"
set new_mail_command = "notify-send 'New mail'"
set nm_default_uri = "notmuch:///home/jane/mail"
