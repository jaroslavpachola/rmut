# StartupNotify is false on purpose: eframe never reads the Wayland
# activation token gnome-shell passes in $XDG_ACTIVATION_TOKEN, so a
# promised startup sequence never completes and mutter's 'smart' focus
# leaves the new window behind whatever had focus at the time.
[Desktop Entry]
Type=Application
Version=1.0
Name=rmut
GenericName=Mail Client
Comment=rmut in a window: the egui front end
Exec=rmut-egui
TryExec=rmut-egui
Icon=internet-mail
Terminal=false
Categories=Network;Email;
Keywords=mail;maildir;mbox;imap;mutt;
StartupNotify=false
StartupWMClass=rmut-egui
